# Token from @BotFather
BOT_TOKEN=123456789:AAExampleTokenGoesHere

# Postgres connection string.
# On Railway, add a Postgres plugin and this is auto-injected as DATABASE_URL.
# For local testing you can leave this unset to fall back to a local SQLite file.
DATABASE_URL=postgresql://user:password@host:port/dbname

# The chat_id of the PRIVATE channel/group the bot uses as its file vault.
# The bot must be an admin of this channel. See README for how to get this ID.
STORAGE_CHAT_ID=-1001234567890
